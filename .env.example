# FEATHERLESS_API_KEY: Required server-side API key for Featherless AI.
# Used exclusively server-side to call https://api.featherless.ai/v1/chat/completions
# Never exposed in client code or with NEXT_PUBLIC_ prefix.
FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"

# FEATHERLESS_MODEL: Target instruction model identifier on Featherless.
# Defaults to Qwen/Qwen3-VL-8B-Instruct or any valid Featherless Qwen model accessible to your account.
FEATHERLESS_MODEL="Qwen/Qwen3-VL-8B-Instruct"

# SERPER_API_KEY: Dedicated server-side Web Search API key from https://serper.dev
# Enables live Google Search results with structured sources, excerpts, and knowledge graph citations.
# If not configured, AegisFlow automatically falls back to Wikimedia API + Public Web Search.
SERPER_API_KEY="YOUR_SERPER_API_KEY"

# URLHAUS_AUTH_KEY: Official Auth-Key from abuse.ch (https://auth.abuse.ch)
# Enables automated threat intelligence verification of extracted domains and URLs against active global malware and phishing infrastructure feeds.
URLHAUS_AUTH_KEY="YOUR_ABUSE_CH_AUTH_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
