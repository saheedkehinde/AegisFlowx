# FEATHERLESS_API_KEY: Server-side API key for Featherless AI (primary Qwen inference).
FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"

# GEMINI_API_KEY: Server-side Gemini API key (AI Studio injects automatically; used for fallback).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SERPER_API_KEY: Server-side Web Search API key from https://serper.dev for live evidence grounding.
SERPER_API_KEY="YOUR_SERPER_API_KEY"

# URLHAUS_AUTH_KEY: Official Auth-Key from https://auth.abuse.ch for live URLhaus threat-intel checks.
URLHAUS_AUTH_KEY="YOUR_ABUSE_CH_AUTH_KEY"

# NEXT_PUBLIC_SUPABASE_URL: Public Supabase project URL (client/SSR auth, Vault, and rate limiting).
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_URL"

# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: Public Supabase publishable/anon key (browser & SSR auth).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Strictly server-side Supabase service-role key (required in production for distributed rate limiting & search cache).
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

