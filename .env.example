# FEATHERLESS_API_KEY: Required server-side API key for Featherless AI.
# Used exclusively server-side to call https://api.featherless.ai/v1/chat/completions
# Never exposed in client code or with NEXT_PUBLIC_ prefix.
FEATHERLESS_API_KEY="YOUR_FEATHERLESS_API_KEY"

# FEATHERLESS_MODEL: Target instruction model identifier on Featherless.
# Defaults to Qwen/Qwen3-VL-8B-Instruct or any valid Featherless Qwen model accessible to your account.
FEATHERLESS_MODEL="Qwen/Qwen3-VL-8B-Instruct"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
